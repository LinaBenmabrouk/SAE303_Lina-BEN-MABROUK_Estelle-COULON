---
import Layout from "../layouts/Layout.astro";
import { palette } from "../data/palette";
import Section from "../components/Section.astro";
import { etapeDe } from "../data/navigation";
import Figure from "../components/Figure.astro";
import PlotFigure from "../components/PlotFigure.astro";
import ChiffreCle from "../components/ChiffreCle.astro";
import * as Plot from "@observablehq/plot";
import communesCarte from "../assets/communes-carte.json";
import expositionRevenus from "../assets/exposition-revenus.json";
import {
  exposition,
  moyenneMetropole,
  plusExposee,
  moinsExposee,
  formatPart,
  formatNombre,
} from "../data/communes";

const totalExposes = exposition.reduce((total, c) => total + c.exposes, 0);
const communesTresExposees = exposition.filter((c) => c.part > 80);
const classement = [...exposition].sort((a, b) => b.part - a.part);
const bordeaux = exposition.find((c) => c.nom === "Bordeaux")!;

const groupeMin = expositionRevenus.reduce((a, b) => (b.partExposee < a.partExposee ? b : a));
const groupeMax = expositionRevenus.reduce((a, b) => (b.partExposee > a.partExposee ? b : a));
const premierGroupe = expositionRevenus[0];
const dernierGroupe = expositionRevenus[expositionRevenus.length - 1];

const surtitre = "mb-4 text-10 font-bold tracking-surtitre uppercase";
const titre2 = "max-w-27ch text-titre-section font-bold";
const texte2Colonnes = "mt-6.5 grid grid-cols-2 gap-8 text-15 leading-long text-neutral-700 max-md:grid-cols-1 max-md:gap-4";
const bouton = "inline-flex items-center justify-between gap-5 rounded-full border-2 px-5 py-3 text-14 font-bold transition duration-180 survol:-translate-y-0.5 max-md:px-4 max-md:text-13";
const orbite = "absolute rounded-full border-2 border-peche/60";
---

<Layout
  titre="Les habitants"
  description="Environ 70 % des habitants de Bordeaux Métropole vivent dans un îlot de chaleur. Carte par commune et comparaison selon le niveau de vie."
>
  <div class="bg-creme">
  <Section class="relative overflow-hidden bg-linear-115 from-brand-red to-rouge-sombre text-papier contour-jaune" interieur="relative max-w-290 px-gouttiere py-16 max-md:py-10">
    <p class="relative z-1 mb-3 text-12 font-bold tracking-label uppercase opacity-80">{etapeDe("/habitants/")}</p>
    <p class:list={[surtitre, "relative z-1 text-jaune-pale"]}>Population &amp; exposition · Bordeaux Métropole</p>
    <h1 class="relative z-1 max-w-3/4 text-titre-page leading-titre font-bold tracking-titre max-md:max-w-full md:leading-none">Qui sont les plus exposés ?</h1>
    <div class="relative z-1 mt-6 max-w-16/25 text-17 leading-texte text-papier max-md:max-w-full">
      Les {exposition.length} communes de Bordeaux Métropole ont été étudiées pour savoir combien
      d'habitants vivent dans les îlots de chaleur. Les données sur les températures de surface
      datent de 2022, tandis que celles concernant la population et les niveaux de vie
      proviennent de l'INSEE en 2019. Nous allons comparer les communes, puis étudier
      les différences d'exposition selon les niveaux de vie.
    </div>
    <nav class="relative z-1 mt-7 flex max-w-7/10 flex-wrap gap-3.5 max-md:max-w-full" aria-label="Dans cette page">
      <a href="#carte" class:list={[bouton, "border-brand-orange bg-brand-orange text-brand-navy survol:bg-brand-orange-clair survol:shadow-marine"]}>Explorer les communes <span aria-hidden="true">↗</span></a>
      <a href="#revenus" class:list={[bouton, "border-papier text-papier survol:bg-brand-navy survol:shadow-bleu"]}>Comparer les niveaux de vie <span aria-hidden="true">→</span></a>
    </nav>
    <div class="pointer-events-none absolute top-1/2 right-16 size-52.5 -translate-y-1/2 max-md:relative max-md:top-auto max-md:right-auto max-md:mx-auto max-md:mt-8 max-md:size-32.5 max-md:translate-y-0" aria-hidden="true">
      <span class:list={[orbite, "inset-0 animate-orbite-60 border-dashed"]}></span>
      <span class:list={[orbite, "inset-6.5 animate-orbite-40-inverse border-b-transparent max-md:inset-4.5"]}></span>
    </div>
  </Section>

  <Section interieur="max-w-290 px-gouttiere pt-10 pb-14 max-md:pt-7 max-md:pb-10">
    <h2 class="sr-only">Chiffres clés</h2>
    <div class="grid gap-4.5 sm:grid-cols-2 sm:*:last:col-span-2 lg:grid-cols-3 lg:*:last:col-span-1">
      <ChiffreCle compact valeur={Math.round(moyenneMetropole)} unite="%" titre="Une exposition très répandue">
        des habitants de la métropole vivent dans un îlot de chaleur
      </ChiffreCle>
      <ChiffreCle compact valeur={formatNombre(Math.round(totalExposes / 1000) * 1000)} unite="personnes" titre="Des habitants concernés">
        environ vivent dans un îlot de chaleur
      </ChiffreCle>
      <ChiffreCle compact valeur={communesTresExposees.length} unite="communes" titre="Des territoires plus exposés">
        sur {exposition.length} dépassent 80 % d'habitants en îlot de chaleur
      </ChiffreCle>
    </div>
  </Section>

  <Section id="carte" class="border-y border-ligne bg-brume">
    <p class:list={[surtitre, "text-brand-blue"]}>L'exposition près de chez vous</p>
    <h2 class={titre2}>Le centre bien plus exposé que la périphérie</h2>
    <div class={texte2Colonnes}>
      <p>
        Les communes telles que Talence ({formatPart(exposition.find((c) => c.nom === "Talence")!.part)} %),
        Bordeaux ({formatPart(bordeaux.part)} %), Bègles ({formatPart(exposition.find((c) => c.nom === "Bègles")!.part)} %)
        et Le Bouscat ({formatPart(exposition.find((c) => c.nom === "Le Bouscat")!.part)} %)
        comptent plus de 80 % d'habitants vivant dans des îlots de chaleur, selon les estimations.
        Cela montre que les communes situées au centre de la métropole sont généralement les plus exposées.
        Certaines communes périphériques, comme Ambès ({formatPart(exposition.find((c) => c.nom === "Ambès")!.part)} %),
        sont beaucoup moins exposées. Cela peut notamment s'expliquer par la densité urbaine,
        qui favorise la formation d'îlots de chaleur. Les pourcentages représentent la part
        des habitants concernés et non la superficie des communes.
      </p>
      <p>
        Bordeaux pèse lourd dans le total. Avec {formatNombre(bordeaux.habitants)} habitants,
        elle compte à elle seule {formatNombre(bordeaux.exposes)} personnes en îlot de chaleur,
        soit près de {Math.round((bordeaux.exposes / totalExposes) * 10)} sur 10 dans toute la métropole.
      </p>
    </div>

    <Figure
      titre="Plus de 8 habitants sur 10 en îlot de chaleur au centre de la métropole"
      sousTitre="Part des habitants vivant dans une zone au moins 3 °C plus chaude que la moyenne de la métropole, par commune"
      note="Survolez une commune pour voir sa valeur. Les couleurs regroupent les communes en 5 classes."
      source="Bordeaux Métropole 2022 et INSEE Filosofi 2019"
    >
      <PlotFigure
        options={{
          ariaLabel: `Carte des ${exposition.length} communes de Bordeaux Métropole selon la part des habitants en îlot de chaleur`,
          ariaDescription: [
            `Carte des ${exposition.length} communes de Bordeaux Métropole, colorées en 5 classes d'orange, du plus clair au plus foncé.`,
            `La couleur indique la part des habitants qui vivent dans un îlot de chaleur.`,
            `Les communes du centre sont les plus exposées, celles de la périphérie beaucoup moins.`,
            `${plusExposee.nom} est la plus exposée avec ${formatPart(plusExposee.part)} %, suivie de ${classement[1].nom} avec ${formatPart(classement[1].part)} %. ${moinsExposee.nom} est la moins exposée avec ${formatPart(moinsExposee.part)} %.`,
          ].join(" "),
          width: 800,
          projection: { type: "mercator", domain: communesCarte },
          color: {
            type: "threshold",
            domain: [20, 40, 60, 80],
            scheme: palette.carte,
            label: "Part des habitants en îlot de chaleur (%)",
            legend: true,
          },
          marks: [
            Plot.geo(communesCarte, {
              fill: (d) => d.properties.part,
              stroke: "white",
              strokeWidth: 0.6,
              title: (d) => `${d.properties.nom} · ${formatPart(d.properties.part)} %`,
            }),
          ],
        }}
        optionsMobile={{ width: 340 }}
      />
    </Figure>

    <details class="mt-4 rounded-bloc border border-ligne bg-white p-6 max-md:p-4.5">
      <summary class="cursor-pointer text-sm font-semibold text-brand-blue">Voir les données de la carte</summary>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-135 text-left text-13 tabular-nums">
          <caption class="sr-only">
            Part des habitants en îlot de chaleur par commune, de la plus exposée à la moins exposée
          </caption>
          <thead class="bg-neutral-50">
            <tr>
              <th scope="col" class="px-3 py-3.25">Commune</th>
              <th scope="col" class="px-3 py-3.25 text-right">Habitants</th>
              <th scope="col" class="px-3 py-3.25 text-right">En îlot de chaleur</th>
              <th scope="col" class="px-3 py-3.25 text-right">Part</th>
            </tr>
          </thead>
          <tbody>
            {
              classement.map((c) => (
                <tr class="border-b border-neutral-200 last:border-0 hover:bg-neutral-50">
                  <th scope="row" class="px-3 py-3.25 font-normal">{c.nom}</th>
                  <td class="px-3 py-3.25 text-right">{formatNombre(c.habitants)}</td>
                  <td class="px-3 py-3.25 text-right">{formatNombre(c.exposes)}</td>
                  <td class="px-3 py-3.25 text-right">{formatPart(c.part)} %</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>
  </Section>

  <Section id="revenus">
    <p class:list={[surtitre, "text-brand-blue"]}>La chaleur au-delà des revenus</p>
    <h2 class={titre2}>Le niveau de vie ne change presque rien</h2>
    <div class={texte2Colonnes}>
      <p>
        On pourrait penser que les ménages modestes vivent plus souvent dans les
        quartiers les plus chauds. Les données de la métropole ne le montrent pas.
        Nous avons réparti les habitants en 5 groupes de même taille, des plus
        modestes aux plus aisés. Dans chaque groupe, entre {formatPart(groupeMin.partExposee)} %
        et {formatPart(groupeMax.partExposee)} % des habitants vivent dans un îlot
        de chaleur.
      </p>
      <p>
        La chaleur en ville touche donc tout le monde, quel que soit le revenu. Ce
        résultat repose sur des moyennes par carreau de 200 m ou plus. Il peut
        cacher des écarts à l'échelle d'une rue ou d'un immeuble.
      </p>
    </div>

    <Figure
      titre="Environ 7 habitants sur 10 en îlot de chaleur, quel que soit le niveau de vie"
      sousTitre="Part des habitants vivant dans un îlot de chaleur, selon 5 groupes de niveau de vie de même population"
      note={`Le niveau de vie moyen va de ${formatNombre(premierGroupe.niveauVieMoyen)} € par an dans le groupe 1 à ${formatNombre(dernierGroupe.niveauVieMoyen)} € dans le groupe 5.`}
      source="INSEE Filosofi 2019 et Bordeaux Métropole 2022"
    >
      <PlotFigure
        options={{
          ariaLabel: "Diagramme en barres de la part des habitants en îlot de chaleur selon 5 groupes de niveau de vie",
          ariaDescription: [
            `Diagramme en barres verticales, une barre par groupe de niveau de vie, du groupe 1 (les plus modestes) au groupe 5 (les plus aisés).`,
            `Chaque barre donne la part des habitants du groupe qui vivent dans un îlot de chaleur.`,
            `Les cinq barres ont presque la même hauteur, le niveau de vie ne change presque rien.`,
            `Les valeurs vont de ${formatPart(groupeMin.partExposee)} % pour le groupe ${groupeMin.groupe} à ${formatPart(groupeMax.partExposee)} % pour le groupe ${groupeMax.groupe}.`,
          ].join(" "),
          width: 800,
          x: {
            label: "Groupe de niveau de vie (1 = les plus modestes, 5 = les plus aisés)",
            tickFormat: (d) => String(d),
          },
          y: { label: "Part des habitants en îlot de chaleur (%)", domain: [0, 100], grid: true },
          marks: [
            Plot.barY(expositionRevenus, { x: "groupe", y: "partExposee", fill: palette.chaud }),
            Plot.text(expositionRevenus, {
              x: "groupe",
              y: "partExposee",
              text: (d) => formatPart(d.partExposee) + " %",
              dy: -8,
              fontWeight: "bold",
            }),
            Plot.text(expositionRevenus, {
              x: "groupe",
              y: 0,
              text: (d) => `${formatNombre(d.niveauVieMoyen)} €/an`,
              dy: -12,
              fill: "white",
            }),
            Plot.ruleY([0]),
          ],
        }}
        optionsMobile={{
          width: 340,
          x: { label: "Groupe (1 = plus modestes, 5 = plus aisés)", tickFormat: (d) => String(d) },
          y: { label: "Part en îlot de chaleur (%)", domain: [0, 100], grid: true },
          marks: [
            Plot.barY(expositionRevenus, { x: "groupe", y: "partExposee", fill: palette.chaud }),
            Plot.text(expositionRevenus, {
              x: "groupe",
              y: "partExposee",
              text: (d) => Math.round(d.partExposee) + " %",
              dy: -8,
              fontWeight: "bold",
            }),
            Plot.text(expositionRevenus, {
              x: "groupe",
              y: 0,
              text: (d) => `${Math.round(d.niveauVieMoyen / 1000)} k€`,
              dy: -12,
              fill: "white",
            }),
            Plot.ruleY([0]),
          ],
        }}
      />
    </Figure>
  </Section>

  <Section class="px-gouttiere pb-16 max-md:pb-10" interieur="max-w-258 rounded-3xl bg-brand-navy p-encart text-papier contour-orange">
    <p class:list={[surtitre, "text-brand-orange"]}>Passer à l'échelle de votre commune</p>
    <h2 class={titre2}>Et dans ma commune ?</h2>
    <p class="mt-4 max-w-2xl text-15 leading-texte text-neutral-300">
      Retrouvez la part des habitants en îlot de chaleur dans votre commune et
      comparez-la aux autres.
    </p>
    <a href="/ma-commune/" class="mt-7 inline-flex items-center justify-between gap-7.5 rounded-xl bg-brand-orange px-4.5 py-3 text-13 font-bold text-brand-navy transition duration-200 survol:-translate-y-0.5 survol:shadow-encart">
      Voir ma commune
    </a>
  </Section>
  </div>
</Layout>
