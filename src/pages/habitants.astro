---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Figure from "../components/Figure.astro";
import PlotFigure from "../components/PlotFigure.astro";
import ChiffreCle from "../components/ChiffreCle.astro";
import * as Plot from "@observablehq/plot";
import communesCarte from "../assets/communes-carte.json";
import expositionRevenus from "../assets/exposition-revenus.json";
import {
  exposition,
  moyenneMetropole,
  plusExposee,
  moinsExposee,
  formatPart,
  formatNombre,
} from "../data/communes";

const totalExposes = exposition.reduce((total, c) => total + c.exposes, 0);
const communesTresExposees = exposition.filter((c) => c.part > 80);
const classement = [...exposition].sort((a, b) => b.part - a.part);
const bordeaux = exposition.find((c) => c.nom === "Bordeaux")!;

const groupeMin = expositionRevenus.reduce((a, b) => (b.partExposee < a.partExposee ? b : a));
const groupeMax = expositionRevenus.reduce((a, b) => (b.partExposee > a.partExposee ? b : a));
const premierGroupe = expositionRevenus[0];
const dernierGroupe = expositionRevenus[expositionRevenus.length - 1];
---

<Layout
  titre="Les habitants"
  description="Environ 70 % des habitants de Bordeaux Métropole vivent dans un îlot de chaleur. Carte par commune et comparaison selon le niveau de vie."
>
  <div class="habitants-page">
  <Section class="habitants-hero">
    <p class="section-kicker">Population &amp; exposition · Bordeaux Métropole</p>
    <h1 class="text-3xl font-bold tracking-tight md:text-5xl">Les habitants</h1>
    <div class="mt-4 max-w-2xl text-lg text-neutral-700">
      Qui vit dans les zones les plus chaudes de la métropole ? Nous avons croisé
      les îlots de chaleur avec la population, commune par commune, puis selon le
      niveau de vie.
    </div>
    <nav class="habitants-jump" aria-label="Dans cette page">
      <a href="#carte" class="button-primary">Explorer les communes <span aria-hidden="true">↗</span></a>
      <a href="#revenus" class="button-secondary">Comparer les niveaux de vie <span aria-hidden="true">→</span></a>
    </nav>
    <div class="habitants-orbits" aria-hidden="true"><span></span><span></span></div>
  </Section>

  <Section class="habitants-summary">
    <h2 class="sr-only">Chiffres clés</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 sm:[&>:last-child]:col-span-2 lg:[&>:last-child]:col-span-1">
      <ChiffreCle valeur={Math.round(moyenneMetropole)} unite="%" titre="Une exposition très répandue">
        des habitants de la métropole vivent dans un îlot de chaleur
      </ChiffreCle>
      <ChiffreCle valeur={formatNombre(Math.round(totalExposes / 1000) * 1000)} unite="personnes" titre="Des habitants concernés">
        environ vivent dans un îlot de chaleur
      </ChiffreCle>
      <ChiffreCle valeur={communesTresExposees.length} unite="communes" titre="Des territoires plus exposés">
        sur {exposition.length} dépassent 80 % d'habitants en îlot de chaleur
      </ChiffreCle>
    </div>
  </Section>

  <Section id="carte" fond>
    <p class="section-kicker">L'exposition près de chez vous</p>
    <h2 class="text-2xl font-bold">Le centre bien plus exposé que la périphérie</h2>
    <div class="mt-4 max-w-2xl space-y-4 text-neutral-700">
      <p>
        Les communes du cœur de la métropole sont les plus touchées. À Talence,
        à Bordeaux, à Bègles et au Bouscat, plus de 8 habitants sur 10 vivent
        dans un îlot de chaleur. En périphérie, dans des communes
        moins denses comme {moinsExposee.nom} ou Ambès, ils sont moins de 3 %.
      </p>
      <p>
        Bordeaux pèse lourd dans le total. Avec {formatNombre(bordeaux.habitants)} habitants,
        elle compte à elle seule {formatNombre(bordeaux.exposes)} personnes en îlot de chaleur,
        soit près de {Math.round((bordeaux.exposes / totalExposes) * 10)} sur 10 dans toute la métropole.
      </p>
    </div>

    <Figure
      titre="Plus de 8 habitants sur 10 en îlot de chaleur au centre de la métropole"
      sousTitre="Part des habitants vivant dans une zone au moins 3 °C plus chaude que la moyenne de la métropole, par commune"
      note="Survolez une commune pour voir sa valeur. Les couleurs regroupent les communes en 5 classes."
      source="Bordeaux Métropole 2022 et INSEE Filosofi 2019"
    >
      <PlotFigure
        options={{
          ariaLabel: `Carte des ${exposition.length} communes de Bordeaux Métropole selon la part des habitants en îlot de chaleur`,
          ariaDescription: [
            `Carte des ${exposition.length} communes de Bordeaux Métropole, colorées en 5 classes d'orange, du plus clair au plus foncé.`,
            `La couleur indique la part des habitants qui vivent dans un îlot de chaleur.`,
            `Les communes du centre sont les plus exposées, celles de la périphérie beaucoup moins.`,
            `${plusExposee.nom} est la plus exposée avec ${formatPart(plusExposee.part)} %, suivie de ${classement[1].nom} avec ${formatPart(classement[1].part)} %. ${moinsExposee.nom} est la moins exposée avec ${formatPart(moinsExposee.part)} %.`,
          ].join(" "),
          width: 800,
          projection: { type: "mercator", domain: communesCarte },
          color: {
            type: "quantize",
            n: 5,
            range: ["#fff0d9", "#fbd099", "#F8A52C", "#eb701f", "#DB371E"],
            label: "Part des habitants en îlot de chaleur (%)",
            legend: true,
          },
          marks: [
            Plot.geo(communesCarte, {
              fill: (d) => d.properties.part,
              stroke: "white",
              strokeWidth: 0.6,
              title: (d) => `${d.properties.nom} · ${formatPart(d.properties.part)} %`,
            }),
          ],
        }}
        optionsMobile={{ width: 340 }}
      />
    </Figure>

    <details class="mt-4 rounded-xl border border-neutral-200 bg-white p-4">
      <summary class="cursor-pointer font-semibold">Voir les données de la carte</summary>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">
            Part des habitants en îlot de chaleur par commune, de la plus exposée à la moins exposée
          </caption>
          <thead class="border-b border-neutral-300">
            <tr>
              <th scope="col" class="py-2 pr-4">Commune</th>
              <th scope="col" class="py-2 pr-4 text-right">Habitants</th>
              <th scope="col" class="py-2 pr-4 text-right">En îlot de chaleur</th>
              <th scope="col" class="py-2 text-right">Part</th>
            </tr>
          </thead>
          <tbody>
            {
              classement.map((c) => (
                <tr class="border-b border-neutral-200">
                  <th scope="row" class="py-2 pr-4 font-normal">{c.nom}</th>
                  <td class="py-2 pr-4 text-right">{formatNombre(c.habitants)}</td>
                  <td class="py-2 pr-4 text-right">{formatNombre(c.exposes)}</td>
                  <td class="py-2 text-right">{formatPart(c.part)} %</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>
  </Section>

  <Section id="revenus">
    <p class="section-kicker">La chaleur au-delà des revenus</p>
    <h2 class="text-2xl font-bold">Le niveau de vie ne change presque rien</h2>
    <div class="mt-4 max-w-2xl space-y-4 text-neutral-700">
      <p>
        On pourrait penser que les ménages modestes vivent plus souvent dans les
        quartiers les plus chauds. Les données de la métropole ne le montrent pas.
        Nous avons réparti les habitants en 5 groupes de même taille, des plus
        modestes aux plus aisés. Dans chaque groupe, entre {formatPart(groupeMin.partExposee)} %
        et {formatPart(groupeMax.partExposee)} % des habitants vivent dans un îlot
        de chaleur.
      </p>
      <p>
        La chaleur en ville touche donc tout le monde, quel que soit le revenu. Ce
        résultat repose sur des moyennes par carreau de 200 m ou plus. Il peut
        cacher des écarts à l'échelle d'une rue ou d'un immeuble.
      </p>
    </div>

    <Figure
      titre="Environ 7 habitants sur 10 en îlot de chaleur, quel que soit le niveau de vie"
      sousTitre="Part des habitants vivant dans un îlot de chaleur, selon 5 groupes de niveau de vie de même population"
      note={`Le niveau de vie moyen va de ${formatNombre(premierGroupe.niveauVieMoyen)} € par an dans le groupe 1 à ${formatNombre(dernierGroupe.niveauVieMoyen)} € dans le groupe 5.`}
      source="INSEE Filosofi 2019 et Bordeaux Métropole 2022"
    >
      <PlotFigure
        options={{
          ariaLabel: "Diagramme en barres de la part des habitants en îlot de chaleur selon 5 groupes de niveau de vie",
          ariaDescription: [
            `Diagramme en barres verticales, une barre par groupe de niveau de vie, du groupe 1 (les plus modestes) au groupe 5 (les plus aisés).`,
            `Chaque barre donne la part des habitants du groupe qui vivent dans un îlot de chaleur.`,
            `Les cinq barres ont presque la même hauteur, le niveau de vie ne change presque rien.`,
            `Les valeurs vont de ${formatPart(groupeMin.partExposee)} % pour le groupe ${groupeMin.groupe} à ${formatPart(groupeMax.partExposee)} % pour le groupe ${groupeMax.groupe}.`,
          ].join(" "),
          width: 800,
          x: {
            label: "Groupe de niveau de vie (1 = les plus modestes, 5 = les plus aisés)",
            tickFormat: (d) => String(d),
          },
          y: { label: "Part des habitants en îlot de chaleur (%)", domain: [0, 100], grid: true },
          marks: [
            Plot.barY(expositionRevenus, { x: "groupe", y: "partExposee", fill: "#DB371E" }),
            Plot.text(expositionRevenus, {
              x: "groupe",
              y: "partExposee",
              text: (d) => formatPart(d.partExposee) + " %",
              dy: -8,
              fontWeight: "bold",
            }),
            Plot.text(expositionRevenus, {
              x: "groupe",
              y: 0,
              text: (d) => `${formatNombre(d.niveauVieMoyen)} €/an`,
              dy: -12,
              fill: "white",
            }),
            Plot.ruleY([0]),
          ],
        }}
        optionsMobile={{
          width: 340,
          x: { label: "Groupe (1 = plus modestes, 5 = plus aisés)", tickFormat: (d) => String(d) },
          y: { label: "Part en îlot de chaleur (%)", domain: [0, 100], grid: true },
          marks: [
            Plot.barY(expositionRevenus, { x: "groupe", y: "partExposee", fill: "#DB371E" }),
            Plot.text(expositionRevenus, {
              x: "groupe",
              y: "partExposee",
              text: (d) => Math.round(d.partExposee) + " %",
              dy: -8,
              fontWeight: "bold",
            }),
            Plot.text(expositionRevenus, {
              x: "groupe",
              y: 0,
              text: (d) => `${Math.round(d.niveauVieMoyen / 1000)} k€`,
              dy: -12,
              fill: "white",
            }),
            Plot.ruleY([0]),
          ],
        }}
      />
    </Figure>
  </Section>

  <Section class="habitants-next">
    <p class="section-kicker">Passer à l'échelle de votre commune</p>
    <h2 class="text-2xl font-bold">Et dans ma commune ?</h2>
    <p class="mt-4 max-w-2xl text-neutral-700">
      Retrouvez la part des habitants en îlot de chaleur dans votre commune et
      comparez-la aux autres.
    </p>
    <a
      href="/ma-commune/"
      class="method-link"
    >
      Voir ma commune
    </a>
  </Section>
  </div>
</Layout>

<style is:global>
  .habitants-page { background: #fffaf1; }
  .habitants-page .content-section > div { max-width: 1160px; padding: 64px clamp(24px, 5vw, 64px); }
  .habitants-page .section-kicker { font-size: 10px; letter-spacing: .14em; }
  .habitants-page .habitants-hero { position: relative; overflow: hidden; background: linear-gradient(115deg, #db371e, #ab2818); color: #fff8ed; }
  .habitants-hero > div { position: relative; }
  .habitants-hero .section-kicker { position: relative; z-index: 1; color: #fff0c2; }
  .habitants-hero h1 { position: relative; z-index: 1; max-width: 75%; font-size: clamp(2.8rem, 5.5vw, 4.8rem); letter-spacing: -.055em; }
  .habitants-page .habitants-hero .text-neutral-700 { position: relative; z-index: 1; max-width: 64%; color: #fff8ed; line-height: 1.8; font-size: 17px; margin-top: 24px; }
  .habitants-jump { display: flex; position: relative; z-index: 1; flex-wrap: wrap; gap: 14px; margin-top: 28px; max-width: 70%; }
  .habitants-jump a { padding: 12px 20px; border-radius: 999px; font-size: 14px; }
  .habitants-hero .button-primary:is(:hover, :focus-visible) { box-shadow: 5px 5px 0 #051c36, 0 8px 22px rgb(5 28 54 / 20%); }
  .habitants-hero :focus-visible { outline-color: #fff0c2; }
  .habitants-orbits { position: absolute; right: 64px; top: 50%; width: 210px; height: 210px; transform: translateY(-50%); pointer-events: none; }
  .habitants-orbits span { position: absolute; inset: 0; border: 2px dashed rgb(255 224 163 / 60%); border-radius: 50%; animation: orbit-turn 60s linear infinite; }
  .habitants-orbits span + span { inset: 26px; border: 2px solid rgb(255 224 163 / 60%); border-bottom-color: transparent; animation-duration: 40s; animation-direction: reverse; }
  .habitants-page h2 { font-size: clamp(1.9rem, 3.2vw, 2.65rem); max-width: 27ch; }
  .habitants-page .habitants-summary > div { padding-block: 40px 56px; }
  .habitants-summary .grid { gap: 18px; }
  .habitants-summary .key-stat { padding: 26px 24px 34px; }
  .habitants-summary .stat-title { font-size: 13px; margin-bottom: 18px; }
  .habitants-summary .stat-value > span:first-child { font-size: clamp(2.4rem, 3.3vw, 3rem); }
  .habitants-summary .stat-value > span + span { font-size: 17px; }
  .habitants-summary .key-stat > p:last-child { font-size: 13px; }
  .habitants-page #carte { background: #f0f5f8; border-block: 1px solid #e1eaf0; }
  .habitants-page :is(#carte, #revenus) h2 + div { max-width: none; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 26px; font-size: 15px; line-height: 1.85; }
  .habitants-page :is(#carte, #revenus) h2 + div p { margin: 0; }
  .habitants-page .data-figure { padding: clamp(18px, 3vw, 32px); border: 1px solid #e1eaf0; border-radius: 22px; box-shadow: 0 8px 28px rgb(5 28 54 / 4%); }
  .habitants-page .data-figure figcaption { padding-bottom: 18px; border-bottom: 1px solid #eaf1f6; }
  .habitants-page .data-figure figcaption > p:first-child { font-size: clamp(17px, 2vw, 21px); }
  .habitants-page .data-figure figcaption > p + p { font-size: 13px; margin-top: 8px; }
  .habitants-page .data-figure > p { font-size: 12px; line-height: 1.7; }
  .habitants-page .data-figure svg { margin-inline: auto; }
  .habitants-page details { border: 1px solid #e1eaf0; border-radius: 18px; padding: 24px; }
  .habitants-page summary { font-size: 14px; color: #0e68a4; }
  .habitants-page table { min-width: 540px; font-size: 13px; font-variant-numeric: tabular-nums; }
  .habitants-page thead { background: #f3f7fa; border: 0; }
  .habitants-page :is(th, td) { padding: 13px 12px; }
  .habitants-page tbody tr:last-child { border-bottom: 0; }
  .habitants-page tbody tr:hover { background: #f3f7fa; }
  .habitants-page .habitants-next { padding: 0 clamp(24px, 5vw, 64px) 64px; }
  .habitants-page .habitants-next > div { max-width: 1032px; padding: clamp(28px, 4vw, 48px); border-radius: 24px; background: #051c36; color: #fff8ed; }
  .habitants-next .section-kicker { color: #f8a52c; }
  .habitants-next .text-neutral-700 { color: #bdcfde; font-size: 15px; line-height: 1.8; }
  .habitants-next :focus-visible { outline-color: #f8a52c; }
  @media (max-width: 767px) {
    .habitants-page .content-section > div { padding-block: 40px; }
    .habitants-hero h1, .habitants-page .habitants-hero .text-neutral-700, .habitants-jump { max-width: 100%; }
    .habitants-jump a { font-size: 13px; padding: 12px 16px; }
    .habitants-orbits { position: relative; top: auto; right: auto; width: 130px; height: 130px; transform: none; margin: 32px auto 0; }
    .habitants-orbits span + span { inset: 18px; }
    .habitants-page .habitants-summary > div { padding-block: 28px 40px; }
    .habitants-page :is(#carte, #revenus) h2 + div { grid-template-columns: 1fr; gap: 16px; }
    .habitants-page details { padding: 18px; }
    .habitants-page .habitants-next { padding-bottom: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .habitants-orbits span { animation: none; }
  }
</style>
