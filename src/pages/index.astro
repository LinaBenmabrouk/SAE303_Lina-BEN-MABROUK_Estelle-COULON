---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ChiffreCle from "../components/ChiffreCle.astro";
import { rubriques } from "../data/navigation";
import { exposition, moyenneMetropole, formatNombre } from "../data/communes";
import feux from "../assets/feux-par-an.json";
import joursChauds from "../assets/jours-chauds.json";
import photoAccueil from "../assets/image/bordeaux_place.avif";

const hectares2022 = feux.find((d) => d.annee === 2022)?.hectaresGironde ?? 0;
const record = joursChauds
  .filter((d) => d.station.startsWith("Mérignac"))
  .reduce((a, b) => (b.jours30 > a.jours30 ? b : a));

const cartes = rubriques.filter(({ url }) => url !== "/methode/");
---

<Layout>
  <section class="relative isolate overflow-hidden bg-neutral-900 text-white">
    <Image
      src={photoAccueil}
      alt=""
      widths={[640, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-r from-black/85 via-black/60 to-black/30"></div>

    <div class="mx-auto max-w-5xl px-4 py-24 md:py-36">
      <p class="text-sm tracking-widest text-neutral-200 uppercase">Bordeaux Métropole</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight md:text-6xl">
        Qui vit sous la chaleur à Bordeaux ?
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-neutral-200">
        Les jours à 30 °C se multiplient, et en ville certaines rues chauffent bien
        plus que d'autres. À partir de données publiques, ce site mesure qui est
        exposé, commune par commune.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/ma-commune/"
          class="rounded-full bg-white px-5 py-3 font-medium text-neutral-900 hover:bg-neutral-200"
        >
          Voir ma commune
        </a>
        <a
          href="/climat/"
          class="rounded-full border border-white px-5 py-3 font-medium text-white hover:bg-white/10"
        >
          Commencer par le climat
        </a>
      </div>
    </div>
  </section>

  <Section>
    <h2 class="text-2xl font-bold">L'essentiel en trois chiffres</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:[&>:last-child]:col-span-2 lg:[&>:last-child]:col-span-1">
      <ChiffreCle valeur={Math.round(moyenneMetropole)} unite="%">
        des habitants de la métropole vivent dans un îlot de chaleur
      </ChiffreCle>
      <ChiffreCle valeur={record.jours30} unite="jours">
        à 30 °C ou plus à Mérignac en {record.annee}, un record depuis 1950
      </ChiffreCle>
      <ChiffreCle valeur={formatNombre(hectares2022)} unite="hectares">
        brûlés par les incendies de forêt en Gironde en 2022
      </ChiffreCle>
    </div>
  </Section>

  <Section fond>
    <h2 class="text-2xl font-bold">Explorer le sujet</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-2">
      {
        cartes.map(({ url, titre, description }, i) => (
          <li>
            <a
              href={url}
              class="group block h-full rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-900"
            >
              <span class="text-sm font-semibold text-neutral-600">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-1 text-xl font-semibold">
                {titre} <span aria-hidden="true" class="inline-block group-hover:translate-x-1">→</span>
              </h3>
              <p class="mt-2 text-neutral-700">{description}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section>
    <div class="grid gap-8 md:grid-cols-[2fr_1fr] md:items-center">
      <div>
        <h2 class="text-2xl font-bold">Des données ouvertes et vérifiables</h2>
        <p class="mt-4 max-w-2xl text-neutral-700">
          Ce site répond au défi « Prévention des risques à Bordeaux Métropole » de
          l'Open Data University. Il croise les données de Météo-France, de
          Bordeaux Métropole, de l'INSEE et de la base des incendies de forêt sur
          les {exposition.length} communes de la métropole. Toutes nos sources, nos
          calculs et nos limites sont détaillés.
        </p>
      </div>
      <div class="md:text-right">
        <a
          href="/methode/"
          class="inline-block rounded-full bg-neutral-900 px-5 py-3 font-medium text-white hover:bg-neutral-700"
        >
          Voir la méthode
        </a>
      </div>
    </div>
  </Section>
</Layout>
