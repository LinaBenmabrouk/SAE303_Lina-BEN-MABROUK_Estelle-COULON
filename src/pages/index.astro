---
import { Image } from "astro:assets";
import photoAccueil from "../assets/image/bordeaux_place.avif";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ChiffreCle from "../components/ChiffreCle.astro";
import { rubriques } from "../data/navigation";
import { exposition, moyenneMetropole, formatNombre } from "../data/communes";
import feux from "../assets/feux-par-an.json";
import joursChauds from "../assets/jours-chauds.json";

const hectares2022 = feux.find((d) => d.annee === 2022)?.hectaresGironde ?? 0;
const record = joursChauds
  .filter((d) => d.station.startsWith("Mérignac"))
  .reduce((a, b) => (b.jours30 > a.jours30 ? b : a));

const cartes = rubriques.filter(({ url }) => url !== "/methode/");
const pictogrammes = [
  "M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0",
  "M3 21h18M5 21V10h6v11m0-16h7v16M7 13h2m-2 4h2m5-9h2m-2 4h2m-2 4h2M5 7V3m5 2V1m5 2V1",
  "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M15 3.13a4 4 0 0 1 0 7.75M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0",
  "M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0",
];
const intentions = ["Observer", "Localiser", "Comprendre", "Comparer"];
---

<Layout>
  <section class="hero">
    <Image src={photoAccueil} alt="" widths={[640, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="hero-background" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-grid mx-auto max-w-5xl px-4">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Bordeaux Métropole · Enquête en données</p>
        <h1>La ville chauffe.<br />Et <span>nous ?</span></h1>
        <p class="hero-intro">Qui vit sous la chaleur à Bordeaux ? Les jours à 30 °C se multiplient. D'une rue à l'autre, nous ne sommes pas tous exposés de la même façon.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/ma-commune/" class="button-primary rounded-full px-5 py-3">Explorer ma commune <span aria-hidden="true">↗</span></a>
          <a href="/climat/" class="button-secondary rounded-full px-5 py-3">Comprendre le climat <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-footnote">28 communes. Des données publiques. Une réalité à comprendre.</p>
      </div>
      <div class="hero-art">
        <div class="heat-orbit orbit-one" aria-hidden="true"></div>
        <div class="heat-orbit orbit-two" aria-hidden="true"></div>
        <span class="art-label">LE TERRITOIRE SOUS PRESSION</span>
        <img src="/Logo.png" alt="Bordeaux Surchauffe : la ville entre chaleur et Garonne" width="1044" height="1044" class="hero-logo" />
        <a href="/ma-commune/" class="art-sticker" aria-label="Bordeaux en surchauffe : explorer ma commune">Bordeaux<br /><strong>en surchauffe</strong><span aria-hidden="true"> ↗</span></a>
      </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path fill="#0E68A4" d="M-1440 40Q-1080 100 -720 40T0 40T720 40T1440 40T2160 40T2880 40V100H-1440Z" />
      <path fill="#fff8ed" d="M-1440 65Q-1080 110 -720 65T0 65T720 65T1440 65T2160 65T2880 65V100H-1440Z" />
    </svg>
  </section>
  <div class="brand-strip">
    <p class="sr-only">Des étés plus chauds. Des quartiers inégalement exposés. Et votre commune dans tout ça ?</p>
    <div class="brand-strip-track" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="brand-strip-group">
          <span>Des étés plus chauds</span><span class="strip-separator"></span>
          <span>Des quartiers inégalement exposés</span><span class="strip-separator"></span>
          <span>Et votre commune dans tout ça ?</span><span class="strip-separator"></span>
        </div>
      ))}
    </div>
  </div>

  <Section class="stats-section">
    <p class="section-kicker">Comprendre les risques</p>
    <h2 class="text-2xl font-bold">La chaleur nous concerne déjà</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:[&>:last-child]:col-span-2 lg:[&>:last-child]:col-span-1">
      <ChiffreCle valeur={Math.round(moyenneMetropole)} unite="%" titre="La chaleur près de chez vous">
        des habitants de la métropole vivent dans un îlot de chaleur. L'exposition commence dans nos quartiers.
      </ChiffreCle>
      <ChiffreCle valeur={record.jours30} unite="jours" titre="Des chaleurs qui s'installent">
        à 30 °C ou plus à Mérignac en {record.annee}. Un record depuis 1950 qui rappelle l'importance d'anticiper les fortes chaleurs.
      </ChiffreCle>
      <ChiffreCle valeur={formatNombre(hectares2022)} unite="hectares" titre="Des espaces naturels menacés">
        brûlés en Gironde en 2022. Les incendies rappellent la vulnérabilité de notre territoire.
      </ChiffreCle>
    </div>
  </Section>

  <Section fond class="explore-section">
    <p class="section-kicker">02 / Suivre l’enquête</p>
    <h2 class="text-2xl font-bold">Explorer le sujet</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-2">
      {
        cartes.map(({ url, titre, description }, i) => (
          <li>
            <a
              href={url}
              class="topic-card"
            >
              <div class="topic-topline">
                <span class="topic-label">{intentions[i]}</span>
                <svg class="topic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={pictogrammes[i]} /></svg>
              </div>
              <h3>{titre}</h3>
              <p>{description}</p>
              <span class="topic-discover">Découvrir<span class="topic-plus" aria-hidden="true"></span></span>
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section class="sources-section">
    <div class="sources-panel">
      <div class="sources-copy">
        <p class="section-kicker">Transparent, de bout en bout</p>
        <h2 class="text-2xl font-bold">Des données ouvertes et vérifiables</h2>
        <p class="mt-4 max-w-2xl text-neutral-700">
          Ce site répond au défi « Prévention des risques à Bordeaux Métropole » de
          l'Open Data University. Il croise les données de Météo-France, de
          Bordeaux Métropole, de l'INSEE et de la base des incendies de forêt sur
          les {exposition.length} communes de la métropole. Toutes nos sources, nos
          calculs et nos limites sont détaillés.
        </p>
        <ul class="source-tags" aria-label="Organismes sources">
          <li>Météo-France</li><li>Bordeaux Métropole</li><li>INSEE</li><li>Base des incendies de forêt</li>
        </ul>
      </div>
      <div class="sources-method">
        <svg class="method-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h13l5 5v21H7zM20 3v6h5M11 14h10M11 19h10M11 24h6" /></svg>
        <h3>Comprendre nos chiffres</h3>
        <p>Les sources, les calculs et leurs limites, expliqués simplement.</p>
        <a
          href="/methode/"
          class="method-link"
        >
          Voir la méthode <span aria-hidden="true">+</span>
        </a>
      </div>
    </div>
  </Section>
</Layout>
