---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ChiffreCle from "../components/ChiffreCle.astro";
import { rubriques } from "../data/navigation";
import exposition from "../assets/exposition-communes.json";
import feux from "../assets/feux-par-an.json";
import joursChauds from "../assets/jours-chauds.json";

// Chiffres clés, calculés à partir des JSON exportés du notebook
const habitants = exposition.reduce((total, c) => total + c.habitants, 0);
const exposes = exposition.reduce((total, c) => total + c.exposes, 0);
const partExposee = Math.round((exposes / habitants) * 100);
const hectares2022 = feux.find((d) => d.annee === 2022)?.hectaresGironde ?? 0;
const recordMerignac = Math.max(
  ...joursChauds
    .filter((d) => d.station.startsWith("Mérignac"))
    .map((d) => d.jours30),
);

// Cartes de l'accueil : toutes les rubriques sauf « Méthode »
const cartes = rubriques.filter(({ url }) => url !== "/methode/");
---

<Layout>
  <!-- Bandeau d'accueil -->
  <section class="bg-neutral-900 text-white">
    <div class="mx-auto max-w-5xl px-4 py-20 md:py-28">
      <p class="text-sm tracking-widest text-neutral-300 uppercase">
        Bordeaux Métropole
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight md:text-6xl">
        …
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-neutral-300">…</p>
      <a
        href="/ma-commune/"
        class="mt-8 inline-block rounded-full bg-white px-5 py-3 font-medium text-neutral-900 hover:bg-neutral-200"
      >
        Voir ma commune
      </a>
    </div>
  </section>

  <!-- Chiffres clés : les valeurs viennent des données, les phrases sont à écrire -->
  <Section>
    <h2 class="sr-only">Chiffres clés</h2>
    <div class="grid gap-8 md:grid-cols-3">
      <ChiffreCle valeur={partExposee} unite="%">…</ChiffreCle>
      <ChiffreCle valeur={recordMerignac} unite="jours">…</ChiffreCle>
      <ChiffreCle valeur={hectares2022.toLocaleString("fr-FR")} unite="hectares">…</ChiffreCle>
    </div>
  </Section>

  <!-- Cartes vers les rubriques -->
  <Section fond>
    <h2 class="text-2xl font-bold">…</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {
        cartes.map(({ url, titre, description }) => (
          <li>
            <a
              href={url}
              class="block h-full rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-900"
            >
              <h3 class="text-xl font-semibold">{titre} →</h3>
              <p class="mt-2 text-neutral-700">{description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
