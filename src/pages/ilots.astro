---
import Layout from "../layouts/Layout.astro";
import { palette } from "../data/palette";
import Section from "../components/Section.astro";
import { etapeDe } from "../data/navigation";
import Figure from "../components/Figure.astro";
import PlotFigure from "../components/PlotFigure.astro";
import ChiffreCle from "../components/ChiffreCle.astro";
import * as Plot from "@observablehq/plot";
import ecartsIlots from "../assets/ecarts-ilots.json";
import { formatNombre } from "../data/communes";

const somme = (lignes: typeof ecartsIlots) => lignes.reduce((total, d) => total + d.zones, 0);
const chaudes = ecartsIlots.filter((d) => d.delta > 0);
const fraiches = ecartsIlots.filter((d) => d.delta < 0);
const totalZones = somme(ecartsIlots);
const totalChaudes = somme(chaudes);
const totalFraiches = somme(fraiches);
const ecartMax = Math.max(...ecartsIlots.map((d) => d.delta));
const ecartMin = Math.min(...ecartsIlots.map((d) => d.delta));
const partModerees = Math.round((somme(chaudes.filter((d) => d.delta <= 5)) / totalChaudes) * 10);
const annotationV1 = "Écarts faibles non relevés";
const formatEcart = (x: number) => (x > 0 ? `+${x}` : `−${Math.abs(x)}`);

const surtitre = "mb-4 text-10 font-bold tracking-surtitre uppercase";
const titre2 = "max-w-27ch text-titre-section font-bold";
const bouton = "inline-flex items-center justify-between gap-5 rounded-full border-2 px-5 py-3 text-14 font-bold transition duration-180 survol:-translate-y-0.5 max-md:px-4 max-md:text-13";
const orbite = "absolute rounded-full border-2 border-peche/55";
const definition = "rounded-figure border p-definition";
const seuil = "mb-6 flex flex-wrap items-baseline gap-2 text-34 font-bold tracking-logo";
const reperes = [
  ["La surface, pas l'air", "C'est la température du sol et des toits qui est mesurée. L'air que l'on respire peut être moins chaud que la surface."],
  ["Deux journées d'été", "Les relevés datent du 17 juin et du 11 juillet 2022. Un autre jour aurait pu donner des écarts un peu différents."],
  ["Des zones, pas des surfaces", "Le graphique compte des zones. Une petite cour et un grand parking comptent chacun pour une."],
];
---

<Layout
  titre="Îlots de chaleur"
  description="Les îlots de chaleur et de fraîcheur de Bordeaux Métropole en 2022, d'après les températures de surface. Jusqu'à 16 °C au-dessus de la moyenne."
>
  <div class="bg-creme">
  <Section class="relative overflow-hidden bg-linear-115 from-brand-blue to-bleu-sombre text-papier contour-orange" interieur="relative max-w-290 px-gouttiere py-16 max-md:py-10">
    <p class="relative z-1 mb-3 text-12 font-bold tracking-label uppercase opacity-80">{etapeDe("/ilots/")}</p>
    <p class:list={[surtitre, "relative z-1 text-peche"]}>Chaleur &amp; fraîcheur · Bordeaux Métropole</p>
    <h1 class="relative z-1 max-w-3/4 text-titre-page leading-titre font-bold tracking-titre max-md:max-w-full md:leading-none">Les zones les plus chaudes</h1>
    <div class="relative z-1 mt-6 max-w-16/25 text-17 leading-texte text-glace max-md:max-w-full">
      Les températures varient selon les endroits de Bordeaux : certaines zones sont
      plus chaudes que d'autres. D'après les relevés de Bordeaux Métropole, réalisés
      les 17 juin et 11 juillet 2022, il existe des différences de chaleur et de
      fraîcheur au sein de la métropole.
    </div>
    <nav class="relative z-1 mt-7 flex max-w-7/10 flex-wrap gap-3.5 max-md:max-w-full" aria-label="Dans cette page">
      <a href="#definition" class:list={[bouton, "border-brand-orange bg-brand-orange text-brand-navy survol:bg-brand-orange-clair survol:shadow-rouge"]}>Comprendre les îlots <span aria-hidden="true">↗</span></a>
      <a href="#ecarts" class:list={[bouton, "border-papier text-papier survol:bg-brand-navy survol:shadow-bleu"]}>Explorer les écarts <span aria-hidden="true">→</span></a>
    </nav>
    <div class="pointer-events-none absolute top-1/2 right-16 size-52.5 -translate-y-1/2 max-md:relative max-md:top-auto max-md:right-auto max-md:mx-auto max-md:mt-8 max-md:size-32.5 max-md:translate-y-0" aria-hidden="true">
      <span class:list={[orbite, "inset-0 animate-orbite-60 border-dashed"]}></span>
      <span class:list={[orbite, "inset-6.5 animate-orbite-40-inverse border-b-transparent max-md:inset-4.5"]}></span>
    </div>
  </Section>

  <Section id="definition">
    <p class:list={[surtitre, "text-brand-blue"]}>Comprendre les contrastes</p>
    <h2 class={titre2}>De quoi parle-t-on ?</h2>
    <div class="mt-7.5 grid gap-6 md:grid-cols-2">
      <div class:list={[definition, "border-brand-red/15 bg-rose"]}>
        <span class:list={[seuil, "text-brand-red-fonce"]}>+3 °C <span class="text-12 font-medium tracking-normal">ou plus</span></span>
        <h3 class="text-23 leading-select font-semibold">Îlot de chaleur</h3>
        <p class="mt-4 text-15 leading-long text-neutral-700">
          Une zone dont la surface est au moins 3 °C plus chaude que la moyenne de
          la métropole. Bitume, toits, parkings et bâtiments serrés stockent la
          chaleur du soleil et la relâchent lentement.
        </p>
      </div>
      <div class:list={[definition, "border-brand-blue/15 bg-ciel"]}>
        <span class:list={[seuil, "text-brand-blue"]}>−3 °C <span class="text-12 font-medium tracking-normal">ou moins</span></span>
        <h3 class="text-23 leading-select font-semibold">Îlot de fraîcheur</h3>
        <p class="mt-4 text-15 leading-long text-neutral-700">
          Une zone dont la surface est au moins 3 °C plus fraîche que la moyenne.
          Parcs, bois, cours d'eau et sols végétalisés restent plus frais.
        </p>
      </div>
    </div>

    <h3 class="sr-only">Chiffres clés</h3>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 sm:*:last:col-span-2 lg:grid-cols-3 lg:*:last:col-span-1">
      <ChiffreCle compact valeur={formatNombre(totalZones)} unite="zones" titre="Un territoire observé">relevées dans la métropole</ChiffreCle>
      <ChiffreCle compact valeur={formatNombre(totalChaudes)} unite="zones" titre="La chaleur en ville">sont des îlots de chaleur</ChiffreCle>
      <ChiffreCle compact valeur={formatEcart(ecartMax)} unite="°C" titre="Des contrastes marqués">l'écart le plus fort au-dessus de la moyenne</ChiffreCle>
    </div>
  </Section>

  <Section id="ecarts" class="border-y border-ligne bg-brume">
    <p class:list={[surtitre, "text-brand-blue"]}>Lire les données</p>
    <h2 class={titre2}>Plus de zones chaudes que de zones fraîches</h2>
    <div class="mt-6.5 grid grid-cols-2 gap-8 text-15 leading-long text-neutral-700 max-md:grid-cols-1 max-md:gap-4">
      <p>
        {formatNombre(totalZones)} zones ont été relevées dans cette étude, dont {formatNombre(totalChaudes)} zones
        chaudes et {formatNombre(totalFraiches)} zones fraîches. On parle bien de zones et non de superficies.
        La plupart des îlots de chaleur se situent entre +3 et +5 °C au-dessus de la température moyenne
        de Bordeaux Métropole. Mais certains écarts sont plus importants : jusqu'à {formatEcart(ecartMax)} °C
        du côté chaud, contre {formatEcart(ecartMin)} °C du côté frais.
      </p>
      <p>
        Le vide au milieu du graphique n'est pas une erreur. Le fichier ne garde
        que les zones dont l'écart atteint au moins 3 °C. Les zones proches de la
        moyenne n'y figurent pas.
      </p>
    </div>

    <Figure
      titre={`Les écarts vont jusqu'à ${formatEcart(ecartMax)} °C du côté chaud, contre ${formatEcart(ecartMin)} °C du côté frais`}
      sousTitre="Nombre de zones selon l'écart de leur température de surface à la moyenne de la métropole, en 2022"
      note="Chaque barre compte des zones, quelle que soit leur taille. Aucune zone entre −2 et +2 °C, le fichier ne contient que les écarts marqués."
      source="Bordeaux Métropole, îlots de chaleur et de fraîcheur 2022"
    >
      <PlotFigure
        options={{
          ariaLabel: "Histogramme du nombre de zones selon leur écart de température à la moyenne de la métropole",
          ariaDescription: [
            `Histogramme, une barre par degré d'écart, en bleu pour les îlots de fraîcheur et en rouge pour les îlots de chaleur.`,
            `Chaque barre compte le nombre de zones qui ont cet écart de température de surface par rapport à la moyenne de la métropole, en 2022.`,
            `Il y a plus d'îlots de chaleur que de fraîcheur, et les écarts vont plus loin du côté chaud.`,
            `${formatNombre(totalChaudes)} îlots de chaleur et ${formatNombre(totalFraiches)} îlots de fraîcheur. Les écarts vont de ${formatEcart(ecartMin)} à ${formatEcart(ecartMax)} °C. Aucune zone entre −2 et +2 °C.`,
          ].join(" "),
          width: 800,
          x: { label: "Écart à la moyenne de la métropole (°C)" },
          y: { label: "Nombre de zones", grid: true, tickFormat: (d) => formatNombre(d) },
          color: {
            legend: true,
            domain: ["Îlot de fraîcheur", "Îlot de chaleur"],
            range: [palette.frais, palette.chaud],
          },
          marks: [
            Plot.rectY(ecartsIlots, {
              x1: "delta",
              x2: (d) => d.delta + 1,
              y: "zones",
              insetLeft: 0.5,
              insetRight: 0.5,
              fill: (d) => (d.delta > 0 ? "Îlot de chaleur" : "Îlot de fraîcheur"),
              title: (d) => `${formatEcart(d.delta)} °C · ${formatNombre(d.zones)} zone${d.zones > 1 ? "s" : ""}`,
            }),
            Plot.text([annotationV1], { x: 0.5, frameAnchor: "middle", text: (d) => d, lineWidth: 4, fill: palette.repere }),
            Plot.ruleY([0]),
          ],
        }}
        optionsMobile={{
          width: 340,
          x: { label: "Écart à la moyenne (°C)" },
          y: { label: "Zones", grid: true, tickFormat: (d) => formatNombre(d) },
        }}
      />
    </Figure>
  </Section>

  <Section id="a-savoir">
    <p class:list={[surtitre, "text-brand-blue"]}>Garder les bons repères</p>
    <h2 class={titre2}>Ce que mesure ce relevé</h2>
    <ul class="mt-7.5 grid gap-6 md:grid-cols-3">
      {
        reperes.map(([titre, texte]) => (
          <li class="rounded-bloc border border-ligne border-t-3 border-t-brand-blue bg-white p-6.5">
            <h3 class="text-17 leading-carte font-semibold">{titre}</h3>
            <p class="mt-3.5 text-sm leading-texte text-neutral-700">{texte}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section class="px-gouttiere pb-16 max-md:pb-10" interieur="max-w-258 rounded-3xl bg-brand-navy p-encart text-papier contour-orange">
    <p class:list={[surtitre, "text-brand-orange"]}>Et les habitants ?</p>
    <h2 class={titre2}>Qui vit dans ces îlots ?</h2>
    <p class="mt-4 max-w-2xl text-15 leading-texte text-neutral-300">
      Nous avons croisé ces zones avec la population pour savoir combien
      d'habitants vivent dans un îlot de chaleur, commune par commune.
    </p>
    <a href="/habitants/" class="mt-7 inline-flex items-center justify-between gap-7.5 rounded-xl bg-brand-orange px-4.5 py-3 text-13 font-bold text-brand-navy transition duration-200 survol:-translate-y-0.5 survol:shadow-encart">
      Voir les habitants
    </a>
  </Section>
  </div>
</Layout>
