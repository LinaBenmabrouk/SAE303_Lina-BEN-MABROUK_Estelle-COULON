---
import Layout from "../layouts/Layout.astro";
import { palette } from "../data/palette";
import Section from "../components/Section.astro";
import { etapeDe } from "../data/navigation";
import Figure from "../components/Figure.astro";
import PlotFigure from "../components/PlotFigure.astro";
import ChiffreCle from "../components/ChiffreCle.astro";
import * as Plot from "@observablehq/plot";
import feuxParAn from "../assets/feux-par-an.json";
import joursChauds from "../assets/jours-chauds.json";
import { optionsJoursChauds } from "../graphiques/joursChauds";
import { formatNombre } from "../data/communes";

const formatDecimal = (x: number) => x.toFixed(1).replace(".", ",");

const feux2022 = feuxParAn.find((d) => d.annee === 2022)!;
const autresAnnees = feuxParAn.filter((d) => d.annee !== 2022);
const hectaresAutres = autresAnnees.reduce((total, d) => total + d.hectaresGironde, 0);
const ratio2022 = Math.floor(feux2022.hectaresGironde / hectaresAutres);
const pireAvant2022 = autresAnnees.reduce((a, b) => (b.hectaresGironde > a.hectaresGironde ? b : a));
const plusDeFeux = feuxParAn.reduce((a, b) => (b.feuxGironde > a.feuxGironde ? b : a));
const premiereAnnee = feuxParAn[0].annee;
const derniereAnnee = feuxParAn[feuxParAn.length - 1].annee;

const moyenne = (station: string, debut: number, fin: number) => {
  const annees = joursChauds.filter((d: (typeof joursChauds)[number]) => d.station === station && d.annee >= debut && d.annee <= fin);
  return annees.reduce((total, d) => total + d.jours30, 0) / annees.length;
};
const stations = [...new Set(joursChauds.map((d) => d.station))].map((station) => {
  const annees = joursChauds.filter((d) => d.station === station);
  const record = annees.reduce((a, b) => (b.jours30 > a.jours30 ? b : a));
  return {
    station,
    debut: annees[0].annee,
    avant: moyenne(station, 1950, 1979),
    apres: moyenne(station, 1996, 2025),
    record,
  };
});
const merignac = stations.find((s) => s.station.startsWith("Mérignac"))!;
const centreVille = stations.find((s) => s.station.includes("Paulin"))!;

const surtitre = "mb-4 text-10 font-bold tracking-surtitre uppercase";
const titre2 = "max-w-24ch text-titre-section font-bold";
const texte2Colonnes = "mt-6.5 grid grid-cols-2 gap-8 text-15 leading-long text-neutral-700 max-md:grid-cols-1 max-md:gap-4";
const bouton = "inline-flex items-center justify-between gap-5 rounded-full border-2 px-5 py-3 text-14 font-bold transition duration-180 survol:-translate-y-0.5 max-md:px-4 max-md:text-13";
const anneau = "absolute rounded-full border-2 border-brand-red";
---

<Layout
  titre="Le climat"
  description="Incendies de 2022 en Gironde et jours à 30 °C ou plus depuis 1950 à Mérignac, Villenave-d'Ornon et Bordeaux-Paulin."
>
  <div class="bg-creme">
  <Section class="relative overflow-hidden border-b border-brand-orange/25 bg-linear-115 from-jaune-pale to-jaune-dore text-brand-navy" interieur="relative max-w-290 px-gouttiere py-16 max-md:py-10">
    <p class="relative z-1 mb-3 text-12 font-bold tracking-label uppercase opacity-80">{etapeDe("/climat/")}</p>
    <p class="relative z-1 mb-5 max-w-13/20 text-11 font-semibold tracking-label text-brand-blue uppercase max-md:max-w-full max-md:text-10">Chaleur &amp; incendies · Bordeaux Métropole</p>
    <h1 class="text-titre-climat leading-none font-bold tracking-titre">La chaleur s'installe en Gironde</h1>
    <div class="relative z-1 mt-4 max-w-31/50 text-17 leading-texte text-neutral-700 max-md:max-w-full">
      Depuis 1950, les journées à 30 °C ou plus ont fortement augmenté à Bordeaux.
      Sans oublier les énormes incendies de 2022 dans toute la Gironde, qui ont été particulièrement violents.
      C'est pourquoi nous devons nous y intéresser.
    </div>
    <nav class="relative z-1 mt-7 flex max-w-13/20 flex-wrap gap-3.5 max-md:max-w-full max-md:gap-3" aria-label="Dans cette page">
      <a href="#feux" class:list={[bouton, "border-brand-orange bg-brand-orange text-brand-navy survol:bg-brand-orange-clair survol:shadow-rouge"]}>Les incendies de 2022 <span aria-hidden="true">↗</span></a>
      <a href="#jours-chauds" class:list={[bouton, "border-brand-navy text-brand-navy survol:bg-papier survol:shadow-bleu"]}>L'évolution des températures <span aria-hidden="true">→</span></a>
    </nav>
    <div class="pointer-events-none absolute top-1/2 right-gouttiere-large size-57.5 -translate-y-1/2 max-md:relative max-md:top-auto max-md:right-auto max-md:mx-auto max-md:mt-7.5 max-md:size-31.25 max-md:translate-y-0" aria-hidden="true">
      <span class:list={[anneau, "inset-0 animate-orbite-45 border-dashed opacity-70"]}></span>
      <span class:list={[anneau, "inset-5.5 animate-orbite-32-inverse border-3 border-l-brand-red/15 max-md:inset-3.75"]}></span>
      <span class:list={[anneau, "inset-11.25 animate-orbite-24 border-brand-red/35 border-t-brand-red max-md:inset-7.5"]}></span>
    </div>
  </Section>

  <Section interieur="max-w-290 px-gouttiere pt-10 pb-14 max-md:pt-7 max-md:pb-10">
    <h2 class="sr-only">Chiffres clés</h2>
    <div class="grid gap-4.5 sm:grid-cols-2 sm:*:last:col-span-2 lg:grid-cols-3 lg:*:last:col-span-1">
      <ChiffreCle compact valeur={formatNombre(feux2022.hectaresGironde)} unite="hectares" titre="Des forêts sous pression">
        brûlés par les incendies de forêt en Gironde en 2022
      </ChiffreCle>
      <ChiffreCle compact valeur={merignac.record.jours30} unite="jours" titre="Un été qui a marqué la Gironde">
        à 30 °C ou plus à Mérignac en {merignac.record.annee}, un record
      </ChiffreCle>
      <ChiffreCle compact valeur={formatDecimal(merignac.apres / merignac.avant)} unite="fois plus" titre="Une tendance qui s'installe">
        de jours à 30 °C à Mérignac entre 1996 et 2025 qu'entre 1950 et 1979
      </ChiffreCle>
    </div>
  </Section>

  <Section id="feux" class="border-t border-sable">
    <p class:list={[surtitre, "text-brique"]}>Les incendies · Un territoire vulnérable</p>
    <h2 class={titre2}>2022, un été hors norme</h2>
    <div class={texte2Colonnes}>
      <p>
        En 2022, environ {formatNombre(feux2022.hectaresGironde)} hectares ont brûlé en Gironde à cause des incendies.
        C'est plus de {ratio2022} fois la surface cumulée des {autresAnnees.length} autres années étudiées, de 2006 à 2025.
        Cela montre un énorme écart qui suscite des inquiétudes.
      </p>
      <p>
        Il y a eu {feux2022.feuxGironde} incendies recensés en 2022, mais ce n'est pas le record : {" "}
        {plusDeFeux.feuxGironde} incendies ont été recensés en {plusDeFeux.annee}.
        En revanche, les surfaces brûlées en 2022 battent tous les records de la période étudiée en Gironde.
        Malgré les fortes chaleurs, aucune de ces données ne prouve qu'elles sont la cause de ces grands incendies.
      </p>
    </div>

    <Figure
      etroit
      titre={`En 2022, plus de ${ratio2022} fois la surface brûlée des ${autresAnnees.length} autres années réunies`}
      sousTitre={`Surface brûlée par les incendies de forêt en Gironde, par an, de ${premiereAnnee} à ${derniereAnnee}`}
      note={`L'échelle est la même pour toutes les années. À côté de 2022, les autres paraissent presque nulles. La plus forte avant 2022 est ${pireAvant2022.annee}, avec ${formatNombre(pireAvant2022.hectaresGironde)} hectares.`}
      source={`BDIFF, ${premiereAnnee}-${derniereAnnee}`}
    >
      <PlotFigure
        options={{
          ariaLabel: `Diagramme en barres de la surface brûlée en Gironde chaque année, de ${premiereAnnee} à ${derniereAnnee}`,
          ariaDescription: [
            `Diagramme en barres verticales, une barre par année de ${premiereAnnee} à ${derniereAnnee}, l'année 2022 en rouge.`,
            `Chaque barre donne la surface brûlée par les incendies de forêt en Gironde, en hectares.`,
            `L'année 2022 écrase toutes les autres.`,
            `${formatNombre(feux2022.hectaresGironde)} hectares en 2022, contre ${formatNombre(hectaresAutres)} pour les ${autresAnnees.length} autres années réunies. Avant 2022, le maximum est ${formatNombre(pireAvant2022.hectaresGironde)} hectares en ${pireAvant2022.annee}.`,
          ].join(" "),
          width: 800,
          x: { label: null, tickFormat: (d) => String(d) },
          y: { label: "Surface brûlée en Gironde (hectares)", grid: true, tickFormat: (d) => formatNombre(d) },
          marks: [
            Plot.barY(feuxParAn, {
              x: "annee",
              y: "hectaresGironde",
              fill: (d) => (d.annee === 2022 ? palette.miseEnAvant : palette.gris),
              title: (d) => `${d.annee} · ${formatNombre(d.hectaresGironde)} hectares · ${d.feuxGironde} feux`,
            }),
            Plot.text([feux2022], {
              x: "annee",
              y: "hectaresGironde",
              text: (d) => `${formatNombre(d.hectaresGironde)} hectares`,
              dy: -8,
              fontWeight: "bold",
            }),
            Plot.ruleY([0]),
          ],
        }}
        optionsMobile={{
          width: 340,
          x: { label: null, tickFormat: (d) => String(d), ticks: [2006, 2010, 2014, 2018, 2022] },
          y: { label: "Hectares brûlés", grid: true, tickFormat: (d) => formatNombre(d) },
        }}
      />
    </Figure>
  </Section>

  <Section id="jours-chauds" class="border-t border-ligne bg-brume">
    <p class:list={[surtitre, "text-brand-blue"]}>Les températures · Une hausse durable</p>
    <h2 class={titre2}>De plus en plus de jours à 30 °C</h2>
    <div class={texte2Colonnes}>
      <p>
        D'après Météo-France, deux périodes se distinguent fortement : 1950-1979 et 1996-2025.
        Entre 1950 et 1979, on comptait en moyenne {formatDecimal(merignac.avant)} jours à 30 °C ou plus par an à Mérignac.
        Entre 1996 et 2025, cette moyenne atteint {formatDecimal(merignac.apres)} jours.
        Les trois stations étudiées montrent une augmentation des journées très chaudes.
      </p>
      <p>
        La station de Bordeaux-Paulin, en centre-ville, reste la plus chaude, avec
        {" "}{formatDecimal(centreVille.apres)} jours par an sur la période récente. Cela rejoint l'effet
        d'îlot de chaleur, la ville stocke la chaleur.
      </p>
    </div>

    <div class="mt-8 overflow-x-auto rounded-bloc border border-ligne bg-white p-6 max-md:p-4" tabindex="0" role="region" aria-label="Comparaison des stations météo">
      <table class="w-full min-w-135 text-left text-13 tabular-nums">
        <caption class="mb-2 pb-4 text-left text-15 font-semibold text-brand-navy">
          Jours à 30 °C ou plus par an, en moyenne
        </caption>
        <thead class="bg-neutral-50">
          <tr>
            <th scope="col" class="px-3 py-3.5">Station</th>
            <th scope="col" class="px-3 py-3.5 text-right">1950-1979</th>
            <th scope="col" class="px-3 py-3.5 text-right">1996-2025</th>
            <th scope="col" class="px-3 py-3.5 text-right">Record</th>
          </tr>
        </thead>
        <tbody>
          {
            stations.map((s) => (
              <tr class="border-b border-neutral-200 last:border-0">
                <th scope="row" class="px-3 py-3.5 font-normal">{s.station}</th>
                <td class="px-3 py-3.5 text-right">
                  {formatDecimal(s.avant)}
                  {s.debut > 1950 && <span class="text-neutral-600"> (depuis {s.debut})</span>}
                </td>
                <td class="px-3 py-3.5 text-right font-bold text-brand-blue">{formatDecimal(s.apres)}</td>
                <td class="px-3 py-3.5 text-right">{s.record.jours30} jours en {s.record.annee}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <Figure
      etroit
      titre="De plus en plus de jours à 30 °C ou plus depuis 1950"
      sousTitre="Nombre de jours par an où la température maximale atteint 30 °C ou plus, dans trois stations de la métropole"
      note="Les points sont les années, les lignes la moyenne des 10 dernières années. Seules les années complètes sont gardées."
      source="Météo-France, 1950-2025"
    >
      <PlotFigure
        options={{
          ...optionsJoursChauds(joursChauds, {
            anneeAnnotee: merignac.record.annee,
            texteAnnotation: `Record ${merignac.record.annee}, ${merignac.record.jours30} jours`,
          }),
          ariaLabel: "Nuage de points et courbes du nombre de jours à 30 °C ou plus par an dans trois stations, depuis 1950",
          ariaDescription: [
            `Nuage de points avec une courbe par station, pour Mérignac, Villenave-d'Ornon et Bordeaux-Paulin, de 1950 à 2025.`,
            `Chaque point donne le nombre de jours de l'année où la température maximale atteint 30 °C ou plus. Les courbes montrent la moyenne des 10 dernières années.`,
            `Les trois courbes montent nettement sur la période.`,
            `À Mérignac, la moyenne passe de ${formatDecimal(merignac.avant)} jours par an entre 1950 et 1979 à ${formatDecimal(merignac.apres)} entre 1996 et 2025. Le record est ${merignac.record.annee}, avec ${merignac.record.jours30} jours à Mérignac et ${centreVille.record.jours30} au centre-ville.`,
          ].join(" "),
        }}
        optionsMobile={optionsJoursChauds(joursChauds, {
          largeur: 340,
          anneeAnnotee: merignac.record.annee,
          texteAnnotation: `Record ${merignac.record.annee}`,
        })}
      />
    </Figure>
  </Section>

  <Section class="px-gouttiere py-14 max-md:py-9" interieur="relative max-w-258 overflow-hidden rounded-3xl bg-brand-navy p-encart text-papier contour-orange">
    <p class:list={[surtitre, "text-brand-orange"]}>Comprendre l'exposition près de chez vous</p>
    <h2 class="text-titre-encart font-bold">Où fait-il le plus chaud en ville ?</h2>
    <p class="mt-4 max-w-55ch text-15 text-neutral-300">
      Toutes les rues ne chauffent pas de la même façon. Découvrez les îlots de
      chaleur et de fraîcheur relevés dans la métropole.
    </p>
    <a href="/ilots/" class="mt-7 inline-flex items-center justify-between gap-7.5 rounded-xl bg-brand-orange px-4.5 py-3 text-13 font-bold text-brand-navy transition duration-200 survol:-translate-y-0.5 survol:shadow-encart">
      Voir les îlots de chaleur
    </a>
  </Section>
  </div>
</Layout>
