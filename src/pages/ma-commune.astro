---
import Layout from "../layouts/Layout.astro";
import EnTetePage from "../components/EnTetePage.astro";
import Section from "../components/Section.astro";
import Figure from "../components/Figure.astro";
import {
  exposition,
  listeCommunes,
  plusExposee,
  moinsExposee,
  infosCommune,
  formatPart,
  formatNombre,
  phraseEcart,
} from "../data/communes";

// Premier affichage (avant le JavaScript) : Bordeaux
const communeParDefaut = "Bordeaux";
const infos = infosCommune(communeParDefaut);
---

<Layout titre="Ma commune">
  <!-- Chapeau de la page : la question du lecteur (consigne V4) -->
  <EnTetePage titre="Ma commune">
    Ma commune est-elle plus exposée à la chaleur que les autres ? Choisissez-la
    et comparez-la aux {exposition.length - 1} autres communes de Bordeaux Métropole.
  </EnTetePage>

  <Section id="choix">
    <div class="grid gap-8 md:grid-cols-[18rem_1fr] md:items-start">
      <!-- Colonne de gauche : reste visible pendant le défilement (sur ordinateur) -->
      <div class="space-y-4 md:sticky md:top-24">
        <!-- Choix de la commune -->
        <div>
          <label for="commune" class="block font-semibold">Choisissez votre commune</label>
          <!-- Flèche native masquée (appearance-none) et remplacée par une flèche bien placée -->
          <div class="relative mt-2">
            <select
              id="commune"
              class="w-full appearance-none rounded-lg border border-neutral-300 bg-white py-2 pr-10 pl-3 text-lg"
            >
              {
                listeCommunes.map((nom) => (
                  <option selected={nom === communeParDefaut}>{nom}</option>
                ))
              }
            </select>
            <svg
              class="pointer-events-none absolute top-1/2 right-3 size-5 -translate-y-1/2 text-neutral-600"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <p class="mt-2 text-sm text-neutral-600">
            Vous pouvez aussi cliquer sur une barre du graphique.
          </p>
        </div>

        <!-- Résultat principal, annoncé par les lecteurs d'écran à chaque changement -->
        <div
          aria-live="polite"
          aria-atomic="true"
          class="rounded-xl bg-neutral-900 p-5 text-white"
        >
          <p id="nom-commune" class="text-sm tracking-widest text-neutral-300 uppercase">
            {infos.nom}
          </p>
          <p class="mt-1 text-4xl font-bold">
            <span id="part">{formatPart(infos.part)}</span> %
          </p>
          <p class="text-sm text-neutral-300">des habitants vivent dans un îlot de chaleur</p>
          <p id="ecart" class="mt-3 text-sm text-neutral-300">{phraseEcart(infos.ecart)}</p>
        </div>

        <!-- Détail de la commune -->
        <dl class="divide-y divide-neutral-200 rounded-xl border border-neutral-200 text-sm">
          <div class="flex justify-between gap-4 p-3">
            <dt class="text-neutral-600">Habitants</dt>
            <dd id="habitants" class="font-bold">{formatNombre(infos.habitants)}</dd>
          </div>
          <div class="flex justify-between gap-4 p-3">
            <dt class="text-neutral-600">En îlot de chaleur</dt>
            <dd id="exposes" class="font-bold">{formatNombre(infos.exposes)}</dd>
          </div>
          <div class="flex justify-between gap-4 p-3">
            <dt class="text-neutral-600">Rang (1 = la plus exposée)</dt>
            <dd class="font-bold">
              <span id="rang">{infos.rang}</span> sur {exposition.length}
            </dd>
          </div>
        </dl>

        <p class="text-sm text-neutral-600">
          L'adresse de la page change avec la commune, vous pouvez la partager.
        </p>
      </div>

      <!-- Colonne de droite : V4 · graphique calculé dans le navigateur (route B, TP4) -->
      <div class="min-w-0 [&>figure]:mt-0">
        <Figure
          titre={`Selon la commune, de ${Math.round(moinsExposee.part)} % à ${Math.round(plusExposee.part)} % des habitants vivent dans un îlot de chaleur`}
          sousTitre="Part des habitants vivant dans une zone au moins 3 °C plus chaude que la moyenne de la métropole, par commune"
          note="La ligne en pointillés indique la moyenne de la métropole. Les habitants viennent des carreaux INSEE de 2019, les îlots des relevés de l'été 2022."
          source="Bordeaux Métropole 2022 et INSEE Filosofi 2019"
        >
          <div id="graphique" class="min-h-[676px]"></div>
        </Figure>
      </div>
    </div>
  </Section>

  <Section fond>
    <h2 class="text-2xl font-bold">Et les autres communes ?</h2>
    <p class="mt-4 max-w-2xl text-neutral-700">
      La carte montre la part des habitants en îlot de chaleur dans les 28
      communes de la métropole.
    </p>
    <a
      href="/habitants/#carte"
      class="mt-6 inline-block rounded-full bg-neutral-900 px-5 py-3 font-medium text-white hover:bg-neutral-700"
    >
      Voir la carte
    </a>
  </Section>
</Layout>

<script>
  // Importe la librairie Plot (Astro sert de « packageur », TP4)
  import * as Plot from "@observablehq/plot";
  // Importe les données et les calculs communs
  import {
    exposition,
    listeCommunes,
    moyenneMetropole,
    plusExposee,
    moinsExposee,
    infosCommune,
    formatPart,
    formatNombre,
    phraseEcart,
  } from "../data/communes";

  // Récupère les éléments de la page
  const selectCommune = document.getElementById("commune") as HTMLSelectElement;
  const divGraphique = document.getElementById("graphique") as HTMLDivElement;
  const ecrire = (id: string, texte: string) => {
    (document.getElementById(id) as HTMLElement).textContent = texte;
  };

  // Si l'adresse contient une commune (ex. /ma-commune/#Talence), on la sélectionne (TP3, location.hash)
  const communeDansUrl = decodeURIComponent(location.hash.slice(1));
  if (listeCommunes.includes(communeDansUrl)) selectCommune.value = communeDansUrl;

  // Fonction pour afficher la fiche et le graphique
  function renderPlot() {
    // Récupère la commune choisie
    const communeChoisie = selectCommune.value;
    const infos = infosCommune(communeChoisie);

    // Met à jour la fiche
    ecrire("nom-commune", infos.nom);
    ecrire("part", formatPart(infos.part));
    ecrire("ecart", phraseEcart(infos.ecart));
    ecrire("habitants", formatNombre(infos.habitants));
    ecrire("exposes", formatNombre(infos.exposes));
    ecrire("rang", String(infos.rang));

    // Vide le graphique précédent
    divGraphique.innerHTML = "";

    // Crée le graphique avec Plot (code du notebook, plus la ligne de moyenne)
    const plot = Plot.plot({
      // Texte alternatif en 4 temps (la fin est complétée avec la commune choisie)
      ariaLabel: `Diagramme en barres de la part des habitants en îlot de chaleur dans les ${exposition.length} communes de Bordeaux Métropole`,
      ariaDescription: [
        // 1. La nature
        `Diagramme en barres horizontales, une barre par commune, de la plus exposée à la moins exposée.`,
        // 2. Ce qui est mesuré
        `Chaque barre donne la part des habitants qui vivent dans un îlot de chaleur.`,
        // 3. La conclusion
        `L'exposition change beaucoup d'une commune à l'autre.`,
        // 4. Les valeurs remarquables
        `${plusExposee.nom} est la plus exposée avec ${formatPart(plusExposee.part)} %, ${moinsExposee.nom} la moins exposée avec ${formatPart(moinsExposee.part)} %. La moyenne de la métropole est de ${formatPart(moyenneMetropole)} %.`,
        `${infos.nom} est en rouge avec ${formatPart(infos.part)} %, rang ${infos.rang} sur ${exposition.length}.`,
      ].join(" "),
      // Largeur de la colonne (le graphique s'adapte à la place disponible)
      width: divGraphique.clientWidth || 640,
      height: exposition.length * 22 + 60,
      marginLeft: 180,
      marginTop: 30,
      x: { label: "Part des habitants en îlot de chaleur (%)", domain: [0, 100], grid: true },
      y: { label: null },
      marks: [
        Plot.barX(exposition, {
          x: "part",
          y: "nom",
          sort: { y: "-x" },
          fill: (d) => (d.nom === communeChoisie ? "#b2182b" : "#d9d9d9"),
          // Infobulle au survol
          title: (d) => `${d.nom} · ${formatPart(d.part)} %`,
        }),
        Plot.text(exposition, {
          x: "part",
          y: "nom",
          text: (d) => formatPart(d.part) + " %",
          dx: 4,
          textAnchor: "start",
          filter: (d) => d.nom === communeChoisie,
        }),
        // Moyenne de la métropole
        Plot.ruleX([moyenneMetropole], { stroke: "#404040", strokeDasharray: "4,3" }),
        Plot.text([moyenneMetropole], {
          x: (d) => d,
          frameAnchor: "top",
          dy: -12,
          text: () => "Moyenne de la métropole",
        }),
        Plot.ruleX([0]),
      ],
    });

    // Ajoute le graphique à la div
    divGraphique.append(plot);

    // Clic sur une barre : choisit la commune (les barres sont dans l'ordre des données)
    plot.querySelectorAll('g[aria-label="bar"] rect').forEach((rect, i) => {
      (rect as SVGRectElement).style.cursor = "pointer";
      rect.addEventListener("click", () => choisirCommune(exposition[i].nom));
    });
  }

  // Change la commune : met à jour le select, l'adresse et le graphique
  function choisirCommune(nom: string) {
    selectCommune.value = nom;
    history.replaceState(null, "", "#" + encodeURIComponent(nom));
    renderPlot();
  }

  // À chaque changement : met la commune dans l'adresse et redessine
  selectCommune.addEventListener("change", () => choisirCommune(selectCommune.value));

  // Redessine si la fenêtre change de taille (le graphique suit la largeur de la colonne)
  window.addEventListener("resize", renderPlot);

  // Affiche le graphique au chargement de la page
  renderPlot();
</script>
