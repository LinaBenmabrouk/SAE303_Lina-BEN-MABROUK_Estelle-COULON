---
import Logo from "../assets/icones/logo.svg";
import { site } from "../data/site";
import { rubriques, memeChemin } from "../data/navigation";

const cheminActuel = Astro.url.pathname;
---

<header class="sticky top-0 z-20 border-b border-neutral-200 bg-white/95 backdrop-blur">
  <div class="relative mx-auto flex h-14 max-w-5xl items-center justify-between px-4 md:h-16">
    <a href="/" class="flex items-center gap-2 text-lg font-semibold tracking-tight">
      <Logo class="size-7" aria-hidden="true" />
      {site.nom}
    </a>

    <button
      id="bouton-menu"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      class="-mr-2 flex size-11 items-center justify-center rounded-lg hover:bg-neutral-100 md:hidden"
    >
      <span class="sr-only">Menu</span>
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path class="icone-ouvrir" d="M4 7h16M4 12h16M4 17h16" />
        <path class="icone-fermer hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <nav
      id="menu-principal"
      aria-label="Menu principal"
      class="max-md:absolute max-md:inset-x-0 max-md:top-full max-md:hidden max-md:border-b max-md:border-neutral-200 max-md:bg-white max-md:shadow-lg"
    >
      <ul class="flex flex-col gap-1 p-3 md:flex-row md:p-0 md:text-sm">
        {
          rubriques.map(({ url, titre }) => (
            <li>
              <a
                href={url}
                aria-current={memeChemin(url, cheminActuel) ? "page" : undefined}
                class="block rounded-lg px-4 py-3 text-neutral-700 hover:bg-neutral-100 aria-[current=page]:bg-neutral-900 aria-[current=page]:text-white md:rounded-full md:px-3 md:py-1.5"
              >
                {titre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const bouton = document.getElementById("bouton-menu") as HTMLButtonElement;
  const menu = document.getElementById("menu-principal") as HTMLElement;

  function basculerMenu(ouvrir: boolean) {
    bouton.setAttribute("aria-expanded", String(ouvrir));
    menu.classList.toggle("max-md:hidden", !ouvrir);
    bouton.querySelector(".icone-ouvrir")?.classList.toggle("hidden", ouvrir);
    bouton.querySelector(".icone-fermer")?.classList.toggle("hidden", !ouvrir);
  }

  bouton.addEventListener("click", () => {
    basculerMenu(bouton.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (evt) => {
    if (evt.key === "Escape" && bouton.getAttribute("aria-expanded") === "true") {
      basculerMenu(false);
      bouton.focus();
    }
  });
</script>
