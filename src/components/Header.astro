---
import { rubriques, memeChemin } from "../data/navigation";

const cheminActuel = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-20 border-b border-neutral-200 bg-white/95 backdrop-blur">
  <div class="relative mx-auto flex h-14 max-w-5xl items-center justify-between px-4 md:h-16">
    <a href="/" class="site-brand flex items-center gap-2 text-lg font-semibold tracking-tight">
      <img src="/Logo.png" alt="" width="64" height="64" class="brand-logo" />
      <span class="brand-wordmark">Bordeaux<span>Surchauffe</span></span>
    </a>

    <button
      id="bouton-menu"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      class="-mr-2 flex size-11 items-center justify-center rounded-lg hover:bg-neutral-100 md:hidden"
    >
      <span class="sr-only">Menu</span>
      <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav
      id="menu-principal"
      aria-label="Menu principal"
      class="site-nav"
      data-open="false"
    >
      <ul class="flex flex-col gap-1 p-3 md:flex-row md:p-0 md:text-sm">
        {
          rubriques.map(({ url, titre }) => (
            <li>
              <a
                href={url}
                aria-current={memeChemin(url, cheminActuel) ? "page" : undefined}
                class="block rounded-lg px-4 py-3 text-neutral-700 hover:bg-neutral-100 aria-[current=page]:bg-neutral-900 aria-[current=page]:text-white md:rounded-full md:px-3 md:py-1.5"
              >
                <span>{titre}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const bouton = document.getElementById("bouton-menu") as HTMLButtonElement;
  const menu = document.getElementById("menu-principal") as HTMLElement;
  const mobile = window.matchMedia("(max-width: 767px)");

  function basculerMenu(ouvrir: boolean) {
    bouton.setAttribute("aria-expanded", String(ouvrir));
    menu.dataset.open = String(ouvrir);
    menu.inert = mobile.matches && !ouvrir;
    bouton.setAttribute("aria-label", ouvrir ? "Fermer le menu" : "Ouvrir le menu");
  }

  bouton.addEventListener("click", () => {
    basculerMenu(bouton.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (evt) => {
    if (evt.key === "Escape" && bouton.getAttribute("aria-expanded") === "true") {
      basculerMenu(false);
      bouton.focus();
    }
  });
  document.addEventListener("click", (evt) => {
    if (bouton.getAttribute("aria-expanded") === "true" && evt.target instanceof Node && !menu.contains(evt.target) && !bouton.contains(evt.target)) basculerMenu(false);
  });
  menu.addEventListener("click", (evt) => {
    if (evt.target instanceof Element && evt.target.closest("a")) basculerMenu(false);
  });
  mobile.addEventListener("change", () => basculerMenu(false));
  basculerMenu(false);
</script>
