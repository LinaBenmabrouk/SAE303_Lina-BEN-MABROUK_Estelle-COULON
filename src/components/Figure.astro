---
const { titre, sousTitre, note, source } = Astro.props;
---

<figure class="mt-8 rounded-xl border border-neutral-200 bg-white p-3 sm:p-4 md:p-6">
  <figcaption>
    <p class="text-base font-semibold sm:text-lg">{titre}</p>
    {sousTitre && <p class="text-sm text-neutral-700 sm:text-base">{sousTitre}</p>}
  </figcaption>

  <div class="mt-4">
    <slot />
  </div>

  {note && <p class="mt-4 text-sm text-neutral-700">{note}</p>}
  {source && <p class="mt-1 text-sm text-neutral-600">Source · {source}</p>}
</figure>
