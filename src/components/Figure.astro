---
const { titre, sousTitre, note, source, etroit = false, compact = false } = Astro.props;
---

<figure class:list={["mt-8 rounded-figure border border-ligne bg-white shadow-carte", compact ? "p-figure-compact" : "p-figure"]}>
  <figcaption class="border-b border-neutral-100 pb-4.5">
    <p class:list={["font-semibold", compact ? "text-19 leading-carte" : "text-titre-figure leading-legende", etroit && "max-w-55ch"]}>{titre}</p>
    {sousTitre && <p class="mt-2 text-13 text-neutral-700">{sousTitre}</p>}
  </figcaption>

  <div class="mt-4">
    <slot />
  </div>

  {note && <p class:list={["mt-4 text-xs leading-note text-neutral-700", etroit && "max-w-95ch"]}>{note}</p>}
  {source && <p class="mt-1 text-xs leading-note text-neutral-600">Source · {source}</p>}
</figure>
