---
import { rubriques, memeChemin } from "../data/navigation";

// Page affichée, pour signaler le lien actif
const cheminActuel = Astro.url.pathname;
---

<nav aria-label="Menu principal">
  <!-- Sur mobile, le menu défile horizontalement au lieu de prendre plusieurs lignes -->
  <ul class="-mx-4 flex gap-1 overflow-x-auto px-4 text-sm md:mx-0 md:px-0">
    {
      rubriques.map(({ url, titre }) => (
        <li class="shrink-0">
          <a
            href={url}
            aria-current={memeChemin(url, cheminActuel) ? "page" : undefined}
            class="block rounded-full px-3 py-1.5 text-neutral-700 hover:bg-neutral-100 aria-[current=page]:bg-neutral-900 aria-[current=page]:text-white"
          >
            {titre}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
