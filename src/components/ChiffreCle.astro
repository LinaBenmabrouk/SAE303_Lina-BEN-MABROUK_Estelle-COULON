---
const { valeur, unite, titre, compact = false } = Astro.props;
---

<div
  class:list={[
    "relative isolate h-full overflow-hidden rounded-stat border border-brand-blue/25 bg-brand-navy text-papier shadow-stat",
    "before:absolute before:-bottom-6 before:-left-1/10 before:-z-1 before:h-9.5 before:w-6/5 before:-rotate-3 before:rounded-t-demi before:bg-brand-blue before:opacity-75",
    "after:absolute after:-top-16.25 after:-right-11.25 after:-z-1 after:size-35 after:rounded-full after:border-4 after:border-brand-red/55 after:outline-3 after:outline-offset-18 after:outline-brand-red/35 after:outline-dashed",
    compact ? "px-6 pt-6.5 pb-8.5" : "px-6.5 pt-7.5 pb-10.5",
  ]}
>
  {
    titre && (
      <h3 class:list={["relative leading-carte font-semibold", compact ? "mb-4.5 text-13" : "mb-5.5"]}>
        {titre}
      </h3>
    )
  }
  <p class="relative flex flex-wrap items-baseline gap-x-2 font-bold text-brand-orange">
    <span
      class:list={[
        "leading-chiffre tracking-chiffre whitespace-nowrap sm:leading-none",
        compact ? "text-chiffre-compact" : "text-chiffre max-md:text-chiffre-mobile",
      ]}
    >
      {valeur}
    </span>
    {unite && <span class:list={[compact ? "text-17" : "text-xl sm:text-2xl lg:text-xl"]}>{unite}</span>}
  </p>
  <p class:list={["relative mt-3 max-w-34ch text-neutral-200", compact ? "text-13" : "text-15 leading-note"]}>
    <slot />
  </p>
</div>
