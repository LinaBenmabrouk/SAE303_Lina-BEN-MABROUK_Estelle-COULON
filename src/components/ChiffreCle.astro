---
// Carte « chiffre clé » : un grand nombre, son unité en plus petit, puis une phrase (slot).
// Toujours mettre l'unité dans « unite » (%, jours, hectares, °C...) pour que
// toutes les cartes aient la même allure.
const { valeur, unite } = Astro.props;
---

<div class="h-full rounded-xl border border-neutral-200 bg-white p-6">
  <p class="flex flex-wrap items-baseline gap-x-2 font-bold">
    <span class="text-5xl tracking-tight whitespace-nowrap">{valeur}</span>
    {unite && <span class="text-2xl">{unite}</span>}
  </p>
  <p class="mt-3 text-neutral-700"><slot /></p>
</div>
