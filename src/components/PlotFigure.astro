---
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";

const { options, optionsMobile } = Astro.props;

const plot = Plot.plot({ ...options, document: new JSDOM("").window.document });
const plotMobile = optionsMobile
  ? Plot.plot({ ...options, ...optionsMobile, document: new JSDOM("").window.document })
  : null;
---

{
  plotMobile ? (
    <>
      <div class="hidden sm:block" set:html={plot.outerHTML} />
      <div class="sm:hidden" set:html={plotMobile.outerHTML} />
    </>
  ) : (
    <div set:html={plot.outerHTML} />
  )
}
