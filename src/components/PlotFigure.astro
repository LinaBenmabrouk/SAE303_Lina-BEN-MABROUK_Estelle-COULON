---
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";

const { options, optionsMobile } = Astro.props;

const sansEtiquettesInternes = (graphique: Element) => {
  graphique.querySelectorAll("g[aria-label]").forEach((groupe) => groupe.removeAttribute("aria-label"));
  return graphique;
};

const plot = sansEtiquettesInternes(Plot.plot({ ...options, document: new JSDOM("").window.document }));
const plotMobile = optionsMobile
  ? sansEtiquettesInternes(Plot.plot({ ...options, ...optionsMobile, document: new JSDOM("").window.document }))
  : null;
---

{
  plotMobile ? (
    <>
      <div class="hidden sm:block" set:html={plot.outerHTML} />
      <div class="sm:hidden" set:html={plotMobile.outerHTML} />
    </>
  ) : (
    <div set:html={plot.outerHTML} />
  )
}
