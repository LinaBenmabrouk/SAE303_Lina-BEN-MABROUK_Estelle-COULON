---
// Bandeau en haut des pages intérieures : titre (h1) et chapeau (slot)
import Section from "./Section.astro";

const { titre } = Astro.props;
---

<Section fond class="border-b border-neutral-200">
  <h1 class="text-3xl font-bold tracking-tight md:text-5xl">{titre}</h1>
  <div class="mt-4 max-w-2xl text-lg text-neutral-700">
    <slot />
  </div>
</Section>
