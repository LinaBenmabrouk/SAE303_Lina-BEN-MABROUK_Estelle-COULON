---
import Logo from "../assets/icones/logo.svg";
import IconeGithub from "../assets/icones/github.svg";
import IconeObservable from "../assets/icones/observable.svg";
import { site } from "../data/site";
import { rubriques } from "../data/navigation";
---

<footer class="bg-neutral-900 text-sm text-neutral-300">
  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-10 md:grid-cols-[1fr_auto] md:py-12">
    <div>
      <a href="/" class="flex items-center gap-2 text-lg font-semibold text-white">
        <Logo class="size-7" aria-hidden="true" />
        {site.nom}
      </a>
      <p class="mt-3 max-w-xs">
        Un regard sur la chaleur à Bordeaux Métropole à partir de données publiques.
      </p>
    </div>

    <nav aria-labelledby="footer-rubriques">
      <h2 id="footer-rubriques" class="font-semibold text-white">Navigations</h2>
      <ul class="mt-3 space-y-3 md:space-y-2">
        {
          rubriques.map(({ url, titre }) => (
            <li>
              <a href={url} class="hover:text-white hover:underline">{titre}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-neutral-700">
    <div
      class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-5 md:flex-row md:items-center md:justify-between"
    >
      <p>
        <span class="block md:inline">{site.auteurs}</span>
        <span class="hidden md:inline"> · </span>
        <span class="block md:inline">{site.formation}</span>
      </p>
      <p class="flex items-center gap-4">
        <a href={site.notebook} aria-label="Notebook Observable" title="Notebook Observable" class="hover:text-white">
          <IconeObservable class="size-6" aria-hidden="true" />
        </a>
        <a href={site.depot} aria-label="Code sur GitHub" title="Code sur GitHub" class="hover:text-white">
          <IconeGithub class="size-6" aria-hidden="true" />
        </a>
      </p>
    </div>
  </div>
</footer>
