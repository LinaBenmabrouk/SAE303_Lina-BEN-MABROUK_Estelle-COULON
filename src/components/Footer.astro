---
import IconeGithub from "../assets/icones/github.svg";
import IconeObservable from "../assets/icones/observable.svg";
import { site } from "../data/site";
import { rubriques } from "../data/navigation";
---

<footer class="site-footer text-sm text-neutral-300">
  <div class="footer-main footer-container">
    <div class="footer-about">
      <a href="/" class="site-brand flex items-center gap-2 text-lg font-semibold text-white">
        <img src="/Logo.png" alt="" width="64" height="64" class="brand-logo" />
        <span class="brand-wordmark">Bordeaux<span>Surchauffe</span></span>
      </a>
      <p class="mt-3 max-w-xs">
        Un regard sur la chaleur à Bordeaux Métropole à partir de données publiques.
      </p>
    </div>

    <nav aria-labelledby="footer-rubriques">
      <h2 id="footer-rubriques" class="footer-heading">Explorer</h2>
      <ul class="footer-links">
        {
          rubriques.map(({ url, titre }) => (
            <li>
              <a href={url} class="hover:text-white hover:underline">{titre}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="footer-resources">
      <h2 class="footer-heading">Les coulisses du projet</h2>
      <p>Retrouvez les analyses et le code qui donnent vie aux données.</p>
      <ul class="footer-links">
        <li><a href={site.notebook} class="footer-resource"><IconeObservable class="size-5" aria-hidden="true" /><span><span class="footer-resource-prefix">Les analyses sur </span>Observable</span></a></li>
        <li><a href={site.depot} class="footer-resource"><IconeGithub class="size-5" aria-hidden="true" /><span><span class="footer-resource-prefix">Le code sur </span>GitHub</span></a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div
      class="footer-container footer-credits"
    >
      <p class="footer-authors">
        <span class="footer-credit-label">Un projet réalisé par</span>
        <span>{site.auteurs}</span>
      </p>
      <p>{site.formation}</p>
      <a href="#contenu" class="footer-back">Retour en haut <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
